# Hyperliquid API 配置
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WALLET_ADDRESS=
HYPERLIQUID_PRIVATE_KEY=

# 跟单目标地址（可以是钱包地址或金库地址）
# 钱包示例: 0x0ba5de43fa2419a25c2e680f84aff3a8f57fce22
# 金库示例: 0xd6e56265890b76413d1d527eb9b75e334c0c5b42
TARGET_WALLET_ADDRESS=

# 交易模式
SIMULATED_TRADING=true
SIMULATED_ACCOUNT_BALANCE=10000.0

# 跟单交易设置
COPY_OPEN_POSITIONS=true
COPY_EXISTING_ORDERS=true
AUTO_ADJUST_SIZE=true
USE_LIMIT_ORDERS=false  # 为 true 时将市价单转为以当前价格挂限价单
LEVERAGE_ADJUSTMENT=1.0  # 0.5 = 使用目标杠杆的50%（更安全），1.0 = 完全匹配
MAX_OPEN_TRADES=x
MAX_OPEN_ORDERS=x
MAX_ACCOUNT_EQUITY=x        # x 表示无限制，如需设置上限请填入数值

# 资产过滤
BLOCKED_ASSETS=  # 不跟单的资产，逗号分隔（如 BTC,ETH,SOL）

# Telegram 机器人（稍后添加令牌）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 数据库
DATABASE_URL=sqlite:///./data/trading.db

# 日志
LOG_LEVEL=INFO
LOG_FILE=./logs/trading.log
